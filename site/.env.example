# EDGAR refuses undeclared clients: a bare User-Agent gets 403 "Request Rate
# Threshold Exceeded" on the first request. Put a real contact here.
SEC_USER_AGENT="Conviction/0.1 (you@example.com)"

# Prices and bars. The live market-data source: set both and the app switches
# off its sample generator by itself. A paper-only account issues these from an
# email address alone — no funding, no card, no identity check — and its free
# plan gives aggregate bars back to 2016 and snapshots at 200 requests/minute,
# fifteen minutes behind the market.
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
#
# Set this only on a paid plan, where the API is not delayed. It changes what
# the page claims about its own numbers, so it is opt-in.
# ALPACA_REALTIME=false
#
# The trading API host, used only for the asset list that names ETFs. Paper keys
# work against the paper host and live keys against api.alpaca.markets; market
# data takes either. Default is the paper host.
# ALPACA_TRADING_BASE=https://paper-api.alpaca.markets

# The only paid dependency. Set a monthly budget and an alert threshold in
# OpenAI's dashboard, and use a project-scoped key for this app so a runaway
# loop cannot reach the rest of the credits.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

# Consensus analyst target (free tier: 25 requests/day, so cache hard).
# ALPHAVANTAGE_KEY=

# Where the read-through cache writes. Defaults to .cache locally and
# /tmp/conviction-cache on Vercel. Set to "off" for memory-only.
# CACHE_DIR=.cache
